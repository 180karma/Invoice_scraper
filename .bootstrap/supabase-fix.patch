+// Postgres refuses NUL and unpaired surrogates (PDF text can carry both), and one bad row would stall the whole queue
+function sbSafe(v) {
+  if (typeof v === 'string') {
+    let s = v.indexOf('\u0000') >= 0 ? v.replace(/\u0000/g, '') : v;
+    if (!/[\ud800-\udfff]/.test(s)) return s;
+    if (typeof s.toWellFormed === 'function') return s.toWellFormed();
+    let out = '';
+    for (let i = 0; i < s.length; i++) {
+      const c = s.charCodeAt(i);
+      if (c >= 0xd800 && c <= 0xdbff && (s.charCodeAt(i + 1) & 0xfc00) === 0xdc00) { out += s[i] + s[i + 1]; i++; }
+      else out += (c & 0xf800) === 0xd800 ? '\ufffd' : s[i];
+    }
+    return out;
+  }
+  if (Array.isArray(v)) return v.map(sbSafe);
+  if (v && typeof v === 'object') { const o = {}; for (const [k, x] of Object.entries(v)) o[sbSafe(k)] = sbSafe(x); return o; }
+  return v;
+}
