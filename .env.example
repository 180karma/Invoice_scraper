# Copy to .env (which git ignores) and fill in. Then run: node scripts/make-config.mjs
# The page reads the Supabase values from the generated config.js.

# Supabase project URL and its anon or publishable key (Project Settings, API Keys).
# Never put the service_role or secret key here: it would end up in a public page.
SUPABASE_URL=https://xvdxdaujllhiircrstcu.supabase.co
SUPABASE_ANON_KEY=

# Only for running the Edge Function locally (supabase functions serve --env-file .env),
# or for scripts/push-gemini-secret.mjs to upload it. The page never reads it;
# on Supabase it lives in the project secrets (Edge Functions → Secrets).
GEMINI_API_KEY=

# Personal access token from https://supabase.com/dashboard/account/tokens
# Used only by scripts/push-gemini-secret.mjs (optional; you can paste the Gemini key in the dashboard instead).
SUPABASE_ACCESS_TOKEN=
